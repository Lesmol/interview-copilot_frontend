{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Interview Co-Pilot BFF API",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/sessions" : {
      "post" : {
        "tags" : [ "live-controller" ],
        "operationId" : "createSession",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/utterances" : {
      "post" : {
        "tags" : [ "live-controller" ],
        "operationId" : "addUtterance",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UtteranceRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UtteranceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/end" : {
      "post" : {
        "tags" : [ "live-controller" ],
        "operationId" : "endSession",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/v1/accounts/sign-up" : {
      "post" : {
        "tags" : [ "accounts-controller" ],
        "operationId" : "signUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Account created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/password-reset/request" : {
      "post" : {
        "tags" : [ "accounts-controller" ],
        "operationId" : "requestReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted; the response never reveals whether the email has an account",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/password-reset/confirm" : {
      "post" : {
        "tags" : [ "accounts-controller" ],
        "operationId" : "confirmReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetConfirmation"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password changed",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string",
                  "format" : "byte"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/suggestions/{id}" : {
      "patch" : {
        "tags" : [ "live-controller" ],
        "operationId" : "updateSuggestion",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SuggestionStatusRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SuggestionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/whoami" : {
      "get" : {
        "tags" : [ "whoami-controller" ],
        "operationId" : "whoami",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WhoamiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stt-token" : {
      "get" : {
        "tags" : [ "speech-token-controller" ],
        "operationId" : "token",
        "parameters" : [ {
          "name" : "provider",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "deepgram"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SpeechTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/suggestions" : {
      "get" : {
        "tags" : [ "live-controller" ],
        "operationId" : "suggestions",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SuggestionResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/suggestions/stream" : {
      "get" : {
        "tags" : [ "live-controller" ],
        "operationId" : "stream",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Server-sent events; one `suggestion` event per new suggestion",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SuggestionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateSessionRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "interviewee" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "angle" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "interviewType" : {
            "type" : "string"
          },
          "suggestionTypes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "frequency" : {
            "type" : "string"
          }
        },
        "required" : [ "title" ]
      },
      "SessionResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "interviewee" : {
            "type" : "string"
          },
          "angle" : {
            "type" : "string"
          },
          "interviewType" : {
            "type" : "string"
          },
          "suggestionTypes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "frequency" : {
            "type" : "string"
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "frequency", "id", "interviewType", "startedAt", "suggestionTypes", "title" ]
      },
      "UtteranceRequest" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 5000,
            "minLength" : 0
          },
          "speaker" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "startMs" : {
            "type" : "integer",
            "format" : "int64",
            "minimum" : 0
          },
          "endMs" : {
            "type" : "integer",
            "format" : "int64",
            "minimum" : 0
          }
        },
        "required" : [ "text" ]
      },
      "UtteranceResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "seq" : {
            "type" : "integer",
            "format" : "int32"
          },
          "speaker" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          },
          "startMs" : {
            "type" : "integer",
            "format" : "int64"
          },
          "endMs" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "endMs", "id", "seq", "startMs", "text" ]
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 10
          }
        },
        "required" : [ "email", "name", "password" ]
      },
      "PasswordResetRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "PasswordResetConfirmation" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 10
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "SuggestionStatusRequest" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "open", "asked", "dismissed", "pinned" ],
            "minLength" : 1
          }
        },
        "required" : [ "status" ]
      },
      "SuggestionResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sessionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "follow_up", "vague", "contradiction", "aside" ]
          },
          "text" : {
            "type" : "string"
          },
          "quote" : {
            "type" : "string"
          },
          "sourceSeqs" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "status" : {
            "type" : "string",
            "enum" : [ "open", "asked", "dismissed", "pinned" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "createdAt", "id", "sessionId", "sourceSeqs", "status", "text", "type" ]
      },
      "WhoamiResponse" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string"
          }
        }
      },
      "SpeechTokenResponse" : {
        "type" : "object",
        "properties" : {
          "provider" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          },
          "expiresInSeconds" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      }
    }
  }
}
